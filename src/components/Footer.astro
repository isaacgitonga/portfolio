---
import {getSocials} from "@/utils.ts";
import Socials from "@/components/Socials.astro";
---

<footer
  class="bg-background border-t border-neutral-900 text-foreground py-8 mt-20"
>
  <div
    class="max-w-6xl mx-auto px-4 space-y-8 flex flex-col justify-between items-center"
  >
    <p class="text-muted font-montserrat max-w-lg text-center leading-relaxed">
      Built with
      <span class="text-foreground font-semibold font-iceberg">Astro, TypeScript,</span> and,
      <span class="text-foreground font-semibold font-iceberg">Tailwind.</span>
      Designed and developed by
      <span class="text-primary font-semibold font-iceberg text-nowrap">
        <a
          href={getSocials().github}
          target="_blank"
          class="inline text-nowrap hover:underline"
        >
          <span class="px-0.5">Isaac G.</span>
          <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
        </a>
      </span>. Deployed on
      <span class="text-foreground font-semibold font-iceberg">Vercel</span>.
    </p>

    <div class="space-y-2 w-full flex flex-col items-center">
      <!-- <p
        class="text-neutral-700 font-montserrat text-center text-xs max-w-md mt-4"
      >
        Source code available for inspection. Inspiration encouraged;
        attribution appreciated.
      </p> -->

      <Socials gap={6} />
    </div>

    <p class="font-montserrat font-light text-xs text-muted-dark mt-4">
      &copy; <span class="year">{new Date().getFullYear()}</span> Isaac G. All rights reserved.
    </p>
  </div>
</footer>
