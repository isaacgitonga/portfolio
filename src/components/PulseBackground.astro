---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// 71 in 8-bit binary ('G'): 01000111
const bits = [0, 1, 0, 0, 0, 1, 1, 1];

// Design parameters
const yBase = 200;
const yOffset = 70; // Active nodes offset: top is 130, bottom is 270
const startX = 180;
const stepX = 120;
const padding = 80;

// Precompute node positions to alternate active pulses top/bottom
let activeCount = 0;
const nodes = bits.map((bit, index) => {
  const x = startX + index * stepX;
  const isLit = bit === 1;
  let y = yBase;

  if (isLit) {
    // Alternate top (130) and bottom (270)
    y = activeCount % 2 === 0 ? yBase - yOffset : yBase + yOffset;
    activeCount++;
  }

  const labelY = isLit ? (y < yBase ? y - 22 : y + 30) : yBase + 36;

  return { bit, x, y, isLit, labelY };
});

// Construct the main signal path (straight baselines with out-of-phase triangular pulses)
let pathD = `M ${startX - padding} ${yBase}`;
let currentX = startX - padding;

bits.forEach((bit, index) => {
  const nodeX = startX + index * stepX;
  const boundaryLeft = nodeX - stepX / 2;
  const boundaryRight = nodeX + stepX / 2;
  const isLit = bit === 1;

  if (isLit) {
    // If it's an active out-of-phase dot, draw straight to the boundary of the bit,
    // then draw the pulse up/down to the dot and back to the baseline.
    if (currentX !== boundaryLeft) {
      pathD += ` L ${boundaryLeft} ${yBase}`;
    }
    // Alternate top/bottom coordinates matching the node's y
    const nodeY = nodes[index].y;
    pathD += ` L ${nodeX} ${nodeY} L ${boundaryRight} ${yBase}`;
    currentX = boundaryRight;
  } else {
    // Otherwise, draw straight baseline segment through the bit
    pathD += ` L ${boundaryRight} ${yBase}`;
    currentX = boundaryRight;
  }
});

// Finish line
const endX = startX + (bits.length - 1) * stepX + padding;
if (currentX !== endX) {
  pathD += ` L ${endX} ${yBase}`;
}

const filterId = `pulse-glow-${Math.random().toString(36).substring(2, 9)}`;
---

<div class={`absolute inset-0 -z-10 flex items-center justify-center overflow-hidden pointer-events-none select-none`}>
  <svg
    width="100%"
    height="100%"
    viewBox="0 0 1200 400"
    class={`w-full max-w-5xl transition-opacity duration-500 ${className}`}
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Premium glow filter for active elements -->
      <filter id={filterId} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>



    <!-- Ambient Glow Path (wide blur background glow) -->
    <path
      d={pathD}
      fill="none"
      stroke="var(--color-primary)"
      stroke-width="5"
      opacity="0.18"
      filter={`url(#${filterId})`}
    />

    <!-- Main Signal Path -->
    <path
      d={pathD}
      fill="none"
      stroke="var(--color-primary)"
      stroke-width="1.5"
      opacity="0.4"
    />

    <!-- Moving Data Pulse Flow (animated dashes travelling along the path) -->
    <path
      d={pathD}
      fill="none"
      stroke="var(--color-primary)"
      stroke-width="2"
      class="pulse-flow-line"
      filter={`url(#${filterId})`}
    />

    <!-- Render Nodes and Labels -->
    <g>
      {nodes.map(({ bit, x, y, isLit, labelY }) => {
        return (
          <g>
            {/* Outer Radiant Ring: Exclusively for active pulses */}
            {isLit && (
              <circle
                cx={x}
                cy={y}
                r="18"
                fill="none"
                stroke="var(--color-primary)"
                stroke-width="1"
                opacity="0.25"
                class="active-ring"
                filter={`url(#${filterId})`}
              />
            )}

            {/* Core Data Node (placed on baseline if muted, or at the peak if active) */}
            <circle
              cx={x}
              cy={y}
              r={isLit ? "7" : "4.5"}
              fill={isLit ? "var(--color-primary)" : "var(--color-muted)"}
              stroke={isLit ? "var(--color-primary)" : "var(--color-muted)"}
              stroke-width={isLit ? "0" : "2"}
              opacity={isLit ? "0.85" : "0.7"}
              class={isLit ? "active-node" : "idle-node"}
            />

            {/* Discrete Bit Identity Label */}
            <text
              x={x}
              y={labelY}
              text-anchor="middle"
              class="font-mono text-[10px] font-bold tracking-widest"
              style={`
                fill: ${isLit ? 'var(--color-primary)' : 'var(--color-muted)'};
                opacity: ${isLit ? '0.5' : '0.25'};
              `}
            >
              {bit}
            </text>
          </g>
        );
      })}
    </g>
  </svg>
</div>

<style>
  /* Moving pulse flow animation along the signal path */
  @keyframes flow {
    to {
      stroke-dashoffset: -40;
    }
  }
  .pulse-flow-line {
    stroke-dasharray: 8 32;
    animation: flow 2.5s linear infinite;
  }

  /* Breathing pulse glow for active nodes */
  @keyframes node-pulse {
    0%, 100% {
      r: 7px;
      opacity: 0.85;
    }
    50% {
      r: 8.5px;
      opacity: 1;
    }
  }
  .active-node {
    animation: node-pulse 2s ease-in-out infinite;
  }

  /* Expanding ripple ring for active nodes */
  @keyframes ring-expand {
    0% {
      r: 14px;
      opacity: 0.4;
    }
    100% {
      r: 22px;
      opacity: 0;
    }
  }
  .active-ring {
    transform-origin: center;
    animation: ring-expand 2.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  /* Idle pulse to keep muted nodes alive */
  @keyframes idle-breathe {
    0%, 100% {
      opacity: 0.5;
    }
    50% {
      opacity: 0.85;
    }
  }
  .idle-node {
    animation: idle-breathe 4s ease-in-out infinite;
  }
</style>
