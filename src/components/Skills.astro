---
// Skills.astro

interface Tool {
  name: string;
  logoUrl?: string;
  iconClass?: string;
  imgClass?: string;
}

interface Skill {
  id: string;
  title: string;
  paragraphs: string[];
  coreStrengths: string;
  highlight?: {
    icon: string;
    text: string;
  };
  tools: Tool[];
}

const skills: Skill[] = [
  {
    id: "database",
    title: "Database Design",
    paragraphs: [
      "I design databases as <strong>systems</strong>, not just storage layers.",
      "My focus is on data models that reflect real business constraints, enforcing <strong>integrity at the database level</strong> so data remains valid even if application code fails. I prioritize transaction boundaries, indexing strategies, and predictable query behavior under load.",
      "I work comfortably <strong>close to the metal</strong> —analyzing query plans, managing locking strategies, and writing raw SQL—while knowing exactly when to abstract complexity with an ORM. The goal is always the same: clear ownership, consistent performance, and schemas that can evolve without breaking production."
    ],
    coreStrengths: "Relational Modeling, Transactional Integrity, Indexing Strategy, Concurrency Control, Data Migrations.",
    tools: [
      { name: "SQL", logoUrl: "/logos/db.png", imgClass: "bg-cover bg-center size-6" },
      { name: "PostgreSQL", logoUrl: "/logos/postgres.png", imgClass: "bg-cover bg-center h-6 w-8" },
      { name: "MySQL", logoUrl: "/logos/mysql.png", imgClass: "object-cover size-6" },
      { name: "Prisma", logoUrl: "/logos/prisma.png", imgClass: "object-cover rounded-sm size-6" },
      { name: "Redis", logoUrl: "/logos/redis.png", imgClass: "object-cover size-6 rounded-sm" },
      { name: "MongoDB", logoUrl: "/logos/mongodb.png", imgClass: "object-cover size-6" },
      { name: "Neon", logoUrl: "/logos/neon.jpeg", imgClass: "object-cover size-6" }
    ]
  },
  {
    id: "backend",
    title: "Backend Engineering",
    paragraphs: [
      "Backend engineering is my <strong>primary discipline</strong>.",
      "I build APIs and systems where <strong>business logic lives in isolated layers</strong>, independent of frameworks. This decoupling makes systems easier to test, reason about, and scale without being locked into specific tools.",
      "I pay strict attention to <strong>system boundaries</strong>: distinct separation between authentication and authorization, read vs. write models, and synchronous vs. asynchronous flows. Whether handling payments or modernizing legacy systems, I design backends to behave correctly under <strong>real-world conditions</strong> —handling failure states as gracefully as happy paths.",
      "This is my chosen specialization: designing robust, production-grade systems that businesses can rely on."
    ],
    coreStrengths: "API Design, Authentication & Authorization, Transactional Workflows, System Architecture.",
    highlight: {
      icon: "fa-solid fa-gear",
      text: "RESTful API Design"
    },
    tools: [
      { name: "TypeScript", logoUrl: "/logos/typescript.png", imgClass: "size-6" },
      { name: "Node.js", logoUrl: "/logos/node.webp", imgClass: "size-6" },
      { name: "Express", logoUrl: "/logos/express.webp", imgClass: "size-6" },
      { name: "Next.js", logoUrl: "/logos/next.png", imgClass: "size-6" },
      { name: "Postman", logoUrl: "/logos/postman.png", imgClass: "size-6" },
      { name: "Cloudflare", logoUrl: "/logos/cloudflare.png", imgClass: "size-6" },
      { name: "Vercel", logoUrl: "/logos/vercel.png", imgClass: "size-6" },
      { name: "Netlify", logoUrl: "/logos/netlify.png", imgClass: "size-6" }
    ]
  },
  {
    id: "frontend",
    title: "Frontend Engineering",
    paragraphs: [
      "I approach frontend development with the same rigor as backend architecture.",
      "I specialize in <strong>data-dense interfaces</strong> —admin panels, dashboards, and internal tools —where clarity and precision are paramount. Users in these environments need to understand complex data and perform precise actions without fighting the UI.",
      "My focus is on <strong>state synchronization:</strong> data fetching patterns, correct error handling, and cache invalidation. I design interactions where the UI is an accurate reflection of the backend state, ensuring responsiveness without becoming fragile. I build interfaces that users can <strong>trust</strong>."
    ],
    coreStrengths: "Data-Heavy UI Design, Admin Dashboards, Structured Layouts, Predictable State Management, Clean and Maintainable Front-end Architecture.",
    tools: [
      { name: "TypeScript", logoUrl: "/logos/typescript.png", imgClass: "size-6" },
      { name: "Next.js", logoUrl: "/logos/next.png", imgClass: "size-6" },
      { name: "React.js", logoUrl: "/logos/react.png", imgClass: "h-5 w-6" },
      { name: "Tailwind", logoUrl: "/logos/tailwind.png", imgClass: "h-4 w-6" },
      { name: "Tanstack Query", logoUrl: "/logos/tanstack-query.png", imgClass: "size-6" },
      { name: "Redux", logoUrl: "/logos/redux.png", imgClass: "size-6" },
      { name: "Zod", logoUrl: "/logos/zod.png", imgClass: "size-6" },
      { name: "GSAP", logoUrl: "/logos/gsap.png", imgClass: "size-6" },
      { name: "Motion", logoUrl: "/logos/motion.png", imgClass: "size-6" }
    ]
  }
];

const devTools: Tool[] = [
  { name: "Git", logoUrl: "/logos/git.png", imgClass: "size-6" },
  { name: "GitHub", iconClass: "fa-brands fa-github text-2xl" },
  { name: "Linux / Bash", logoUrl: "/logos/bash.png", imgClass: "size-6" },
  { name: "NPM", logoUrl: "/logos/npm.png", imgClass: "h-4 w-6" },
  { name: "PNPM", logoUrl: "/logos/pnpm.webp", imgClass: "size-6" },
  { name: "Gemini", logoUrl: "/logos/gemini.png", imgClass: "size-6" }
];
---
<section id="skills" class="relative max-w-7xl mx-auto py-10 px-4">
  <div class="head">
    <h1
      class="bg-gradient-to-l from-secondary to-primary bg-clip-text text-transparent"
    >
      Skills & Tools
    </h1>
    <p class="space-y-6 max-w-5xl mx-auto text-lg font-medium text-center">
      <span class="block text-xl text-foreground">
        Tools change, but architectural principles endure. I select
        technologies based on stability, ecosystem maturity, and performance
        —never hype.
      </span>
      <span class="block text-muted mt-2">
        While I work comfortably across the full stack, my strongest
        contributions are in
        <strong class="text-foreground font-semibold"
          >database design and backend architecture
        </strong>
        —where system behavior, data integrity, and long-term scalability
        are decided.
      </span>
    </p>
  </div>

  <div class="max-w-6xl mx-auto space-y-16 md:space-y-24 mt-16">
    {skills.map((skill) => (
      <div class={`${skill.id} skill relative grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start`}>
        <!-- Left Content: Description (span 8) -->
        <div class="md:col-span-8 space-y-6">
          <h4 class="title">{skill.title}</h4>

          <div class="desc">
            {skill.paragraphs.map((p) => (
              <p set:html={p} />
            ))}
          </div>

          <div class="space-y-2 mt-4 text-base">
            <span class="text-foreground font-montserrat font-semibold"
              >Core strengths:
            </span>
            <span class="block text-muted">
              {skill.coreStrengths}
            </span>
          </div>

          {skill.highlight && (
            <div
              class="flex gap-4 items-center mt-6 p-3 px-4 text-base text-secondary bg-surface/50 border border-surface-border w-fit rounded-lg"
            >
              <i class={skill.highlight.icon}></i>
              <p class="font-mono font-semibold">{skill.highlight.text}</p>
            </div>
          )}
        </div>

        <!-- Right Content: Tools Card (span 4) -->
        <div class="md:col-span-4 bg-surface/30 border border-surface-border rounded-2xl p-6 shadow-xs">
          <h5 class="font-iceberg font-bold text-lg text-primary mb-4">Technologies & Frameworks</h5>
          <ul class="flex flex-wrap gap-3">
            {skill.tools.map((tool) => (
              <li class="tool">
                {tool.logoUrl ? (
                  <img
                    src={tool.logoUrl}
                    alt={`${tool.name} logo`}
                    class={`img ${tool.imgClass || 'size-6'}`}
                  />
                ) : (
                  <i class={tool.iconClass}></i>
                )}
                <p>{tool.name}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}

    <!-- Dev Tools -->
    <div class="global pt-8 border-t border-surface-border">
      <h3 class="text-2xl py-4 font-iceberg font-semibold text-primary">
        Dev Tools:
      </h3>
      <ul class="flex flex-wrap gap-4 items-center justify-start">
        {devTools.map((tool) => (
          <li class="tool">
            {tool.logoUrl ? (
              <img
                src={tool.logoUrl}
                alt={`${tool.name} logo`}
                class={`img ${tool.imgClass || 'size-6'}`}
              />
            ) : (
              <i class={tool.iconClass}></i>
            )}
            <p>{tool.name}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
