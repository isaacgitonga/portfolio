---
import type { CollectionEntry } from "astro:content";
import { type AstroComponent, ArrowUpRight, CircleCheck } from "@lucide/astro";
import { INQUIRY_CATEGORY_MAP } from "@/constants/inquiryCategories";

interface Props {
  entry: CollectionEntry<"services">;
  icon: AstroComponent;
  index: number;
  variant?: "featured" | "full";
}

const { entry, icon: Icon, index, variant = "full" } = Astro.props;
const service = entry.data;
const categoryLabel = INQUIRY_CATEGORY_MAP[service.category] || service.category;
const isFeatured = variant === "featured";
---

{isFeatured ? (
  <div
    id={`featured-service-${index + 1}`}
    class="group relative flex flex-col justify-between bg-surface/40 hover:bg-surface/75 border border-surface-border hover:border-primary/30 rounded-2xl p-6 transition-all duration-300 backdrop-blur-xs shadow-xs hover:shadow-md hover:shadow-primary/5"
  >
    <div class="space-y-5">
      <!-- Header with Icon & Meta -->
      <div class="flex items-center justify-between gap-5">
        <div class="p-2.5 bg-background border border-surface-border rounded-xl text-primary group-hover:text-foreground group-hover:bg-primary transition-all duration-300 shrink-0">
          <Icon size={20} />
        </div>
        <p class="block text-[10px] font-mono text-primary/80 uppercase tracking-wider font-semibold">
          {categoryLabel}
        </p>
      </div>

      <!-- Title & Summary -->
      <div class="space-y-2">
        <h3 class="text-lg font-iceberg font-bold text-foreground group-hover:text-primary transition-colors duration-200">
          {service.title}
        </h3>
        <p class="text-xs font-montserrat text-muted/90 leading-relaxed line-clamp-3">
          {service.summary}
        </p>
      </div>

      <!-- Deliverables Preview -->
      <div class="space-y-2 pt-2 border-t border-surface-border/30">
        <span class="block text-[10px] uppercase font-mono tracking-wider text-muted-dark font-semibold">
          Deliverables Preview
        </span>
        <div class="space-y-1.5">
          {service.deliverables.slice(0, 2).map((deliv) => (
            <div class="flex items-center gap-1.5 text-xs text-foreground/80">
              <CircleCheck size={12} class="text-emerald-400 shrink-0" />
              <span class="truncate">{deliv}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Card Footer -->
    <div class="mt-6 pt-4 border-t border-surface-border/40 flex items-center justify-between gap-3">
      <div class="font-mono text-[10px] text-muted-dark">
        <span class="block uppercase tracking-wider text-[9px]">Anchor</span>
        <span class="text-secondary font-semibold">{service.pricing.anchorText}</span>
      </div>
      <a
        href={`/inquiry?service=${service.slug}`}
        class="inline-flex items-center gap-1 px-3 py-1.5 bg-primary/10 border border-primary/20 hover:bg-primary hover:text-background text-xs font-iceberg font-bold text-primary rounded-lg transition-all duration-200 shrink-0"
      >
        <span>Inquire</span>
        <ArrowUpRight size={12} />
      </a>
    </div>
  </div>
) : (
  <div
    id={`service-card-${index + 1}`}
    class="group relative flex flex-col justify-between bg-surface/40 hover:bg-surface/75 border border-surface-border hover:border-primary/30 rounded-2xl p-6 md:p-8 transition-all duration-300 backdrop-blur-xs shadow-xs hover:shadow-md hover:shadow-primary/5"
  >
    <div class="space-y-6">
      <!-- Header with Icon & Meta -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="p-2 bg-background border border-surface-border rounded-xl text-primary group-hover:text-foreground group-hover:bg-primary transition-all duration-300 shrink-0">
            <Icon size={24} />
          </div>
          <div>
            <span class="block text-[10px] font-mono text-primary/80 uppercase tracking-wider font-semibold">
              {categoryLabel}
            </span>
          </div>
        </div>
      </div>

      <!-- Title & Summary -->
      <div class="space-y-3">
        <h3 class="text-xl font-iceberg font-bold text-foreground group-hover:text-primary transition-colors duration-200">
          {service.title}
        </h3>
        <p class="text-sm font-montserrat text-muted/90 leading-relaxed">
          {service.summary}
        </p>
      </div>

      <!-- Detailed Breakdown -->
      <div class="space-y-4 pt-2 text-sm font-montserrat border-t border-surface-border/30">
        <!-- Concrete Deliverables -->
        <div>
          <span class="block text-[10px] uppercase font-mono tracking-wider text-foreground font-semibold mb-1.5">
            Concrete Client Deliverables
          </span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
            {service.deliverables.map((deliv) => (
              <div class="flex items-center gap-1.5 text-xs text-foreground/80 bg-background/50 border border-surface-border/40 rounded-lg px-2.5 py-1.5">
                <CircleCheck size={12} class="text-emerald-400 shrink-0" />
                <span class="truncate">{deliv}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Footer (Pricing & Link) -->
    <div class="mt-8 pt-6 border-t border-surface-border/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="font-mono text-xs text-muted-dark">
        <span class="block text-[9px] uppercase tracking-wider">Pricing Anchor & Timeline</span>
        <span class="text-secondary font-semibold">{service.pricing.anchorText}</span>
        <span class="block text-[10px] text-muted-dark font-normal">{service.pricing.timeline}</span>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a
          href={`/inquiry?service=${service.slug}`}
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary/10 border border-primary/20 hover:bg-primary hover:text-background text-xs font-iceberg font-bold text-primary rounded-xl transition-all duration-200"
        >
          <span>Inquire</span>
          <ArrowUpRight size={14} />
        </a>
      </div>
    </div>
  </div>
)}
