---
import { ArrowUpRight, ArrowRight, FileCode, GitBranch } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  specs?: CollectionEntry<"architecture">[];
}

const { specs = [] } = Astro.props;

const rfcBlueprints = [
  {
    id: "outbox-pattern",
    rfcNumber: "RFC-001",
    title: "Asynchronous Payment Checkout Engine (Outbox Pattern)",
    category: "Financial Engineering",
    serviceSlug: "idempotent-payment-billing",
    summary: "Decouples STK push/payment intent creation from charge settlement using transactional outbox tables and compensating transactions.",
    flowSteps: [
      { step: "01", name: "Client Init", desc: "Client sends payment intent with unique UUID idempotency key" },
      { step: "02", name: "State Guard", desc: "Verifies intent state & writes outbox record in DB transaction" },
      { step: "03", name: "Async Gateway", desc: "STK push triggered; webhook callback receiver listens asynchronously" },
      { step: "04", name: "Compensating Task", desc: "Auto-reconciles timeouts via background retry worker" }
    ],
    codeSnippet: `// 1. Transactional Outbox Pattern for Asynchronous Payment Intent
export async function processPaymentIntent(tx: DBTransaction, intent: PaymentIntent) {
  // Enforce idempotency invariant
  const existing = await tx.outbox.findUnique({ where: { key: intent.idempotencyKey } });
  if (existing) return existing.responsePayload;

  // Persist pending outbox record atomically with business logic
  const outbox = await tx.outbox.create({
    data: {
      intentId: intent.id,
      idempotencyKey: intent.idempotencyKey,
      status: 'PENDING',
      payload: intent.payload
    }
  });

  return { outboxId: outbox.id, status: 'QUEUED' };
}`,
    tradeoffs: [
      { label: "Challenge Solved", val: "Webhook duplicate triggers & provider callback delays" },
      { label: "Trade-Off Arbitrage", val: "Slight outbox table storage growth vs. 100% financial correctness" },
      { label: "Scaling Boundary", val: "Sub-5ms intent write latency up to 10k ops/sec" }
    ]
  },
  {
    id: "concurrency-ledger",
    rfcNumber: "RFC-002",
    title: "Concurrency-Safe Inventory & Ticketing Ledger",
    category: "Data Integrity",
    serviceSlug: "system-architecture-audit",
    summary: "Prevents ticket/inventory over-allocation during flash sales using explicit database row-locking without queue starvation.",
    flowSteps: [
      { step: "01", name: "Checkout Request", desc: "High-concurrency user traffic hits inventory checkout endpoint" },
      { step: "02", name: "FOR UPDATE NOWAIT", desc: "Acquires pessimistic row lock on DB item or fails instantly" },
      { step: "03", name: "Atomic Mutation", desc: "Decrements available_units and increments version counter" },
      { step: "04", name: "Audit Trail", desc: "Appends immutable entry to append-only inventory ledger" }
    ],
    codeSnippet: `-- 2. Pessimistic Locking & Versioned Ledger Mutation
BEGIN TRANSACTION;

SELECT id, available_quantity, version
FROM ticket_inventories
WHERE event_id = 'evt_flash_sales' AND tier_id = 'vip'
FOR UPDATE NOWAIT; -- Non-blocking fail-fast to protect DB pool

UPDATE ticket_inventories
SET available_quantity = available_quantity - 1,
    version = version + 1
WHERE id = 'inv_993a' AND available_quantity >= 1;

INSERT INTO inventory_audit_ledger (id, inventory_id, order_id, action)
VALUES (gen_random_uuid(), 'inv_993a', 'ord_881b', 'RESERVE');

COMMIT;`,
    tradeoffs: [
      { label: "Challenge Solved", val: "Race conditions & negative inventory balances during traffic spikes" },
      { label: "Trade-Off Arbitrage", val: "Pessimistic lock overhead vs. zero over-booking guarantee" },
      { label: "Scaling Boundary", val: "~4,500 concurrent mutations/sec per Postgres partition" }
    ]
  },
  {
    id: "tenant-rls",
    rfcNumber: "RFC-003",
    title: "Multi-Tenant Context Isolation (Postgres RLS)",
    category: "Security Architecture",
    serviceSlug: "dedicated-backend-build",
    summary: "Guarantees zero data leakage across customer contexts using database-level Row-Level Security policies and JWT tenant claim extraction.",
    flowSteps: [
      { step: "01", name: "API Middleware", desc: "Extracts verified tenant_id from cryptographically signed JWT" },
      { step: "02", name: "DB Connection", desc: "Sets GUC variable `app.current_tenant_id` for current session" },
      { step: "03", name: "Engine Policy", desc: "Postgres RLS automatically filters ALL queries at engine layer" },
      { step: "04", name: "Zero Bleed", desc: "Attempted cross-tenant queries return 0 rows at database layer" }
    ],
    codeSnippet: `-- 3. Postgres Row-Level Security (RLS) Isolation Policy
ALTER TABLE customer_records ENABLE ROW LEVEL SECURITY;

CREATE POLICY tenant_isolation_policy ON customer_records
  FOR ALL
  USING (
    tenant_id = current_setting('app.current_tenant_id', true)::uuid
  )
  WITH CHECK (
    tenant_id = current_setting('app.current_tenant_id', true)::uuid
  );

-- All SELECT / UPDATE / DELETE operations strictly bounded to active tenant`,
    tradeoffs: [
      { label: "Challenge Solved", val: "Cross-tenant data leaks caused by missing WHERE clauses in app code" },
      { label: "Trade-Off Arbitrage", val: "Strict DB-level policy check vs. complete multi-tenant safety" },
      { label: "Scaling Boundary", val: "Negligible < 0.5% DB CPU overhead for policy evaluation" }
    ]
  }
];
---

<section id="featured-architecture-blueprint" class="max-w-7xl mx-auto px-4 md:px-6 py-16 space-y-12">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-surface-border/40">
    <div class="space-y-3 max-w-2xl">
      <div class="flex items-center gap-2">
        <span class="text-xs uppercase font-mono tracking-widest text-primary font-semibold">Evergreen Engineering Library</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-montserrat font-bold text-foreground">
        Featured Architecture Spec Blueprints
      </h2>
      <p class="text-muted font-montserrat text-base">
        Auditable system specifications detailing topologies, transaction boundaries, failure modes, and trade-off arbitrage.
      </p>
    </div>
    <a
      href="/architecture"
      class="inline-flex items-center gap-2 px-4 py-2.5 bg-surface/60 hover:bg-surface/90 border border-surface-border text-xs font-iceberg font-bold text-foreground rounded-xl transition-all duration-200 shrink-0 cursor-pointer"
    >
      <span>Explore Full RFC Catalog</span>
      <ArrowUpRight size={14} />
    </a>
  </div>

  <!-- Interactive Blueprint Viewer Stage -->
  <div class="bg-[#090d14]/90 border border-primary/20 rounded-2xl shadow-2xl backdrop-blur-xl overflow-hidden font-mono">
    
    <!-- Top Selector Tabs -->
    <div class="flex flex-wrap items-center bg-[#070a10] border-b border-surface-border p-2 gap-2 select-none" id="section5-rfc-tabs">
      {rfcBlueprints.map((rfc, index) => (
        <button
          type="button"
          data-rfc-id={rfc.id}
          class={`section5-tab-btn px-4 py-2 rounded-xl text-xs font-mono transition-all duration-200 cursor-pointer flex items-center gap-2 ${
            index === 0
              ? "bg-primary/15 text-primary border border-primary/30 font-bold"
              : "text-muted hover:text-foreground hover:bg-surface/50 border border-transparent"
          }`}
        >
          <span class="text-[10px] opacity-75">{rfc.rfcNumber}</span>
          <span class="truncate">{rfc.title.split("(")[0]}</span>
        </button>
      ))}
    </div>

    <!-- Active RFC Content Display Stage -->
    <div class="p-6 md:p-8 space-y-6">
      
      <!-- Meta Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-surface-border/60">
        <div class="space-y-1">
          <div class="flex items-center gap-2 text-xs">
            <span class="px-2 py-0.5 bg-primary/10 border border-primary/20 text-primary rounded text-[10px] font-bold" id="rfc-number-tag">
              {rfcBlueprints[0].rfcNumber}
            </span>
            <span class="text-muted-dark text-[11px]" id="rfc-category-tag">
              {rfcBlueprints[0].category}
            </span>
          </div>
          <h3 class="text-xl md:text-2xl font-iceberg font-bold text-foreground" id="rfc-title">
            {rfcBlueprints[0].title}
          </h3>
        </div>

        <a
          id="rfc-inquire-btn"
          href={`/inquiry?service=${rfcBlueprints[0].serviceSlug}`}
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary hover:bg-primary-hover text-background text-xs font-iceberg font-bold rounded-lg transition-all duration-200 shrink-0 cursor-pointer shadow-md shadow-primary/15"
        >
          <span>Inquire for This Architecture</span>
          <ArrowUpRight size={14} />
        </a>
      </div>

      <!-- Flow Steps Topology Sequence -->
      <div class="space-y-3">
        <div class="text-[11px] font-mono text-muted uppercase tracking-wider flex items-center gap-2">
          <GitBranch size={13} class="text-primary" />
          <span>System Topology & Execution Data Flow</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3" id="rfc-flow-container">
          {rfcBlueprints[0].flowSteps.map((step) => (
            <div class="bg-[#05080e] border border-surface-border/80 rounded-xl p-3.5 space-y-1.5">
              <div class="flex items-center justify-between text-[10px]">
                <span class="text-primary font-bold">{step.step}</span>
                <span class="text-muted-dark font-mono">NODE</span>
              </div>
              <div class="text-xs font-bold text-foreground font-montserrat">{step.name}</div>
              <div class="text-[10px] text-muted leading-tight font-montserrat">{step.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Code & Spec Snippet Window -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[11px] text-muted">
          <span class="flex items-center gap-2">
            <FileCode size={13} class="text-primary" />
            <span>Production Specification Blueprint</span>
          </span>
          <span class="text-[10px] text-emerald-400 font-mono">IDEMPOTENCY: GUARANTEED</span>
        </div>
        <div class="relative bg-[#030509] border border-surface-border rounded-xl p-4 overflow-x-auto max-h-[260px] scrollbar-thin">
          <pre id="rfc-code-block" class="text-cyan-300 font-mono text-xs leading-relaxed"><code>{rfcBlueprints[0].codeSnippet}</code></pre>
        </div>
      </div>

      <!-- Trade-Off Arbitrage Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2" id="rfc-tradeoffs-container">
        {rfcBlueprints[0].tradeoffs.map((item) => (
          <div class="bg-surface/30 border border-surface-border/60 rounded-xl p-4 space-y-1">
            <div class="text-[10px] text-muted uppercase tracking-wider">{item.label}</div>
            <div class="text-xs font-bold text-foreground font-montserrat leading-snug">{item.val}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Additional RFC Catalog Articles Grid -->
  {specs.length > 0 && (
    <div class="space-y-4 pt-4">
      <div class="flex items-center justify-between">
        <span class="text-xs uppercase font-mono tracking-widest text-primary font-semibold">
          Published Architecture Articles
        </span>
        <span class="text-xs font-mono text-muted-dark">
          {specs.length} Specs Available
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {specs.map((spec) => (
          <article class="group relative bg-surface/30 hover:bg-surface/60 border border-surface-border hover:border-primary/20 rounded-2xl p-6 transition-all duration-300 backdrop-blur-xs flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs font-mono text-muted-dark">
                <span class="px-2 py-0.5 bg-primary/10 border border-primary/20 text-primary rounded-sm text-[10px] font-semibold">
                  {spec.data.category || "Architecture Spec"}
                </span>
                <span class="text-[10px]">
                  {spec.data.pubDate.toLocaleDateString("en-US", { month: "short", year: "numeric" })}
                </span>
              </div>
              <a href={`/architecture/${spec.id}`}>
                <h4 class="text-lg font-iceberg font-bold text-foreground group-hover:text-primary transition-colors duration-200 line-clamp-2">
                  {spec.data.title}
                </h4>
              </a>
              <p class="text-xs font-montserrat text-muted leading-relaxed line-clamp-3">
                {spec.data.description}
              </p>
            </div>

            <div class="pt-3 border-t border-surface-border/40 flex items-center justify-between">
              <span class="text-[10px] font-mono text-muted-dark">RFC Blueprint</span>
              <a
                href={`/architecture/${spec.id}`}
                class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:text-primary-hover font-mono"
              >
                <span>Read RFC</span>
                <ArrowRight size={13} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  )}
</section>

<script define:vars={{ rfcBlueprints }}>
  document.addEventListener("DOMContentLoaded", () => {
    const tabs = document.querySelectorAll(".section5-tab-btn");
    const rfcNumberEl = document.getElementById("rfc-number-tag");
    const categoryEl = document.getElementById("rfc-category-tag");
    const titleEl = document.getElementById("rfc-title");
    const codeBlockEl = document.getElementById("rfc-code-block");
    const flowContainerEl = document.getElementById("rfc-flow-container");
    const tradeoffsContainerEl = document.getElementById("rfc-tradeoffs-container");
    const inquireBtnEl = document.getElementById("rfc-inquire-btn");

    if (!tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const rfcId = tab.getAttribute("data-rfc-id");
        const selected = rfcBlueprints.find((r) => r.id === rfcId);
        if (!selected) return;

        // Button active styling
        tabs.forEach((t) => {
          t.classList.remove("bg-primary/15", "text-primary", "border-primary/30", "font-bold");
          t.classList.add("text-muted", "border-transparent");
        });
        tab.classList.remove("text-muted", "border-transparent");
        tab.classList.add("bg-primary/15", "text-primary", "border-primary/30", "font-bold");

        // Update header & code
        if (rfcNumberEl) rfcNumberEl.textContent = selected.rfcNumber;
        if (categoryEl) categoryEl.textContent = selected.category;
        if (titleEl) titleEl.textContent = selected.title;
        if (codeBlockEl) codeBlockEl.querySelector("code").textContent = selected.codeSnippet;
        if (inquireBtnEl) inquireBtnEl.setAttribute("href", `/inquiry?service=${selected.serviceSlug}`);

        // Update Flow Steps
        if (flowContainerEl) {
          flowContainerEl.innerHTML = selected.flowSteps
            .map(
              (step) => `
            <div class="bg-[#05080e] border border-surface-border/80 rounded-xl p-3.5 space-y-1.5">
              <div class="flex items-center justify-between text-[10px]">
                <span class="text-primary font-bold">${step.step}</span>
                <span class="text-muted-dark font-mono">NODE</span>
              </div>
              <div class="text-xs font-bold text-foreground font-montserrat">${step.name}</div>
              <div class="text-[10px] text-muted leading-tight font-montserrat">${step.desc}</div>
            </div>
          `
            )
            .join("");
        }

        // Update Trade-Offs
        if (tradeoffsContainerEl) {
          tradeoffsContainerEl.innerHTML = selected.tradeoffs
            .map(
              (item) => `
            <div class="bg-surface/30 border border-surface-border/60 rounded-xl p-4 space-y-1">
              <div class="text-[10px] text-muted uppercase tracking-wider">${item.label}</div>
              <div class="text-xs font-bold text-foreground font-montserrat leading-snug">${item.val}</div>
            </div>
          `
            )
            .join("");
        }
      });
    });
  });
</script>
