---
import TelemetryConsole from "./TelemetryConsole.astro";
import {
  CreditCard,
  ShieldAlert,
  Server,
  Cpu,
  ArrowUpRight,
  ShieldCheck,
  Clock
} from "@lucide/astro";

const authorityPillars = [
  {
    title: "Idempotent Payment Ledgers",
    category: "Financial Engineering",
    description: "Transactional outbox patterns, async checkout engines, and zero double-charging guarantees.",
    icon: CreditCard,
  },
  {
    title: "Multi-Tenant Context Isolation",
    category: "Security & Access",
    description: "Postgres Row-Level Security (RLS), RBAC token claim enforcement, and tenant boundary isolation.",
    icon: ShieldAlert,
  },
  {
    title: "Concurrency-Safe Backends",
    category: "Data Integrity",
    description: "Pessimistic database locking, atomic mutations, and zero over-allocation under peak traffic.",
    icon: Server,
  },
  {
    title: "Deterministic RAG Systems",
    category: "AI Engineering",
    description: "Sandboxed prompt boundaries, strict schema enforcement, and audit-ready agent workflows.",
    icon: Cpu,
  },
];
---

<section id="hero" class="relative z-10 max-w-7xl mx-auto px-4 md:px-6 pt-24 md:pt-32 pb-16 space-y-16">
  <!-- Hero Header Block (2-Column Responsive Layout) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
    <!-- Left Column: Headlines & CTAs -->
    <div class="lg:col-span-7 space-y-6 sm:space-y-8">
      <!-- Status / Role Badge -->
      <div class="hero-badge inline-flex items-center gap-2.5 px-3.5 py-1.5 bg-surface/80 border border-primary/20 rounded-full backdrop-blur-md">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-xs font-mono tracking-wider uppercase text-primary font-semibold">
          Principal Architect & Systems Consultant
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-headline text-4xl sm:text-5xl lg:text-6xl font-montserrat font-bold text-foreground leading-[1.15] tracking-tight">
        Engineering the software components your business <br class="hidden sm:inline" />
        <span class="bg-linear-to-r from-primary via-cyan-400 to-secondary bg-clip-text text-transparent font-iceberg font-normal">
          cannot afford to get wrong.
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="hero-subhead text-lg sm:text-xl font-montserrat font-medium text-muted leading-relaxed max-w-2xl">
        Helping startups and growing platforms build software designed to survive scale. Fixed-scope architectural outcomes that protect data correctness and eliminate 2 AM outages.
      </p>

      <!-- CTAs & 12-Hour SLA Indicator -->
      <div class="space-y-4 pt-2">
        <div class="hero-ctas flex flex-wrap items-center gap-4">
          <a
            href="/inquiry"
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-primary hover:bg-primary-hover text-background font-iceberg font-bold text-base rounded-xl transition-all duration-200 shadow-lg shadow-primary/15 hover:shadow-primary/30 active:scale-98 cursor-pointer"
          >
            <span>Submit System Inquiry</span>
            <ArrowUpRight size={18} />
          </a>
          <a
            href="/services"
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-surface/60 hover:bg-surface/90 border border-surface-border hover:border-primary/30 text-foreground font-iceberg font-bold text-base rounded-xl transition-all duration-200 backdrop-blur-xs cursor-pointer"
          >
            <span>Explore Services</span>
          </a>
        </div>

        <div class="hero-sla flex items-center gap-2 text-xs font-mono text-muted-dark pt-1">
          <Clock size={14} class="text-emerald-400 shrink-0" />
          <span>Guaranteed personal response within 12 hours of submission.</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Visual Hero Element (Interactive Telemetry & Command Console) -->
    <div class="hero-console lg:col-span-5 w-full">
      <TelemetryConsole />
    </div>
  </div>

  <!-- Authority Pillars Grid -->
  <div class="space-y-4 pt-4">
    <div class="flex items-center justify-between">
      <span class="text-xs uppercase font-mono tracking-widest text-primary font-semibold">
        Core Engineering Pillars
      </span>
      <span class="text-xs font-mono text-muted-dark">
        Production-Verified Architecture
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {authorityPillars.map((pillar) => {
        const IconComponent = pillar.icon;
        return (
          <div class="hero-pillar group relative bg-surface/40 hover:bg-surface/75 border border-surface-border hover:border-primary/30 rounded-2xl p-5 transition-all duration-300 backdrop-blur-xs flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <div class="p-2.5 bg-background border border-surface-border rounded-xl text-primary group-hover:bg-primary group-hover:text-background transition-all duration-300 shrink-0">
                  <IconComponent size={20} />
                </div>
                <span class="text-[10px] font-mono text-muted-dark uppercase tracking-wider">
                  {pillar.category}
                </span>
              </div>
              <h3 class="font-iceberg font-bold text-base text-foreground group-hover:text-primary transition-colors duration-200">
                {pillar.title}
              </h3>
              <p class="text-xs font-montserrat text-muted leading-relaxed">
                {pillar.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Core Thesis / Bottleneck Banner -->
  <div class="hero-banner relative bg-linear-to-r from-surface/80 via-surface/40 to-surface/80 border border-primary/20 rounded-2xl p-6 sm:p-8 backdrop-blur-md overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_50%,rgba(56,189,248,0.06),transparent)] pointer-events-none"></div>
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-3xl">
        <div class="flex items-center gap-2">
          <ShieldCheck size={16} class="text-primary shrink-0" />
          <span class="text-xs font-mono uppercase tracking-wider text-primary font-semibold">
            Architectural Philosophy & Risk Arbitrage
          </span>
        </div>
        <blockquote class="text-base sm:text-lg font-montserrat font-semibold text-foreground italic leading-relaxed">
          “I don’t over-engineer your application. I isolate fragile bottlenecks so your core platform can scale without unexpected 2 AM outages.”
        </blockquote>
      </div>
      <div class="shrink-0">
        <a
          href="/about"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary/10 border border-primary/20 hover:bg-primary hover:text-background text-xs font-iceberg font-bold text-primary rounded-lg transition-all duration-200"
        >
          <span>Read Ethos</span>
          <ArrowUpRight size={14} />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { animateHero } from "../animations/hero.ts";
  animateHero();
</script>
