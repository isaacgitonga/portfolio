---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// 71 in 8-bit binary ('G'): 01000111
const bits = [0, 1, 0, 0, 0, 1, 1, 1];

const filterId = `pulse-glow-${Math.random().toString(36).substring(2, 9)}`;
---

<div class={`absolute inset-0 -z-10 flex items-center justify-center overflow-hidden pointer-events-none select-none`}>
  <svg
    width="100%"
    height="100%"
    viewBox="0 0 1200 400"
    class={`w-full max-w-5xl transition-opacity duration-500 ${className}`}
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Premium glow filter for the active data pulses -->
      <filter id={filterId} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>

    <!-- The Pulse Baseline Track -->
    <line x1="100" y1="200" x2="1100" y2="200" stroke="var(--color-muted-dark)" stroke-width="1.5" opacity="0.15" stroke-dasharray="6 6" />

    <g>
      {bits.map((bit, index) => {
        // Space the 8 bits cleanly along the horizontal axis
        const x = 180 + index * 120;
        const y = 200;
        const isLit = bit === 1;

        return (
          <g>
            {/* Outer Radiant Ring: Exclusively for active pulses */}
            {isLit && (
              <circle cx={x} cy={y} r="18" fill="none" stroke="var(--color-primary)" stroke-width="1" opacity="0.25" filter={`url(#${filterId})`} />
            )}

            {/* Core Data Node */}
            <circle
              cx={x}
              cy={y}
              r={isLit ? "7" : "4.5"}
              fill={isLit ? "var(--color-primary)" : "none"}
              stroke={isLit ? "var(--color-primary)" : "var(--color-muted-dark)"}
              stroke-width={isLit ? "0" : "2"}
              opacity={isLit ? "0.85" : "0.3"}
              class="transition-all duration-300"
            />

            {/* Discrete Bit Identity Label underneath */}
            <text
              x={x}
              y={y + 36}
              text-anchor="middle"
              class="font-mono text-[10px] font-bold tracking-widest"
              style={`
                fill: ${isLit ? 'var(--color-primary)' : 'var(--color-muted-dark)'};
                opacity: ${isLit ? '0.5' : '0.15'};
              `}
            >
              {bit}
            </text>
          </g>
        );
      })}
    </g>
  </svg>
</div>