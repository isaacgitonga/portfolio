---
// PriceTiers.astro
---

<div class="space-y-6 w-full">
  <div class="space-y-2">
    <h2 class="text-2xl md:text-3xl font-iceberg font-bold text-foreground">
      Project Scopes & Pricing Brackets
    </h2>
    <p class="text-sm text-muted font-montserrat">
      Select a project classification to pre-fill the intake parameters below.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {/* Card 1: Audits & Consulting */}
    <div data-inquiry="architecture_consulting" class="price-tier-card bg-surface/30 border border-surface-border hover:border-primary/50 hover:bg-surface/50 rounded-xl p-6 transition-all duration-300 flex flex-col justify-between group">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="p-2 bg-primary/10 rounded-lg text-primary text-sm shrink-0">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          </span>
          <span class="text-xs font-mono font-bold text-muted-dark uppercase">[ Audit ]</span>
        </div>
        <div class="space-y-1">
          <h3 class="font-iceberg font-bold text-lg text-foreground group-hover:text-primary transition-colors">
            Diagnostic Audits
          </h3>
          <p class="font-mono text-sm text-primary font-bold">Under $2,500</p>
        </div>
        <p class="text-xs text-muted font-montserrat leading-relaxed">
          Spot scaling bottlenecks, optimize slow queries, review security vulnerabilities, and get structured design recommendations.
        </p>
        <ul class="space-y-2 text-xs font-montserrat text-muted pt-2 border-t border-surface-border/50">
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Database Query Optimization
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Latency & Serverless Audits
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Architecture Blueprint Reviews
          </li>
        </ul>
      </div>
    </div>

    {/* Card 2: Feature Integrations */}
    <div data-inquiry="checkout_payments" class="price-tier-card bg-surface/30 border border-surface-border hover:border-primary/50 hover:bg-surface/50 rounded-xl p-6 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="p-2 bg-primary/10 rounded-lg text-primary text-sm shrink-0">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </span>
          <span class="text-xs font-mono font-bold text-muted-dark uppercase">[ Integration ]</span>
        </div>
        <div class="space-y-1">
          <h3 class="font-iceberg font-bold text-lg text-foreground group-hover:text-primary transition-colors">
            System Integration
          </h3>
          <p class="font-mono text-sm text-primary font-bold">$2,500 - $10,000</p>
        </div>
        <p class="text-xs text-muted font-montserrat leading-relaxed">
          Add checkout portals, design custom ledger payment gates, integrate multi-tenant authorization, or deploy isolated queue workers.
        </p>
        <ul class="space-y-2 text-xs font-montserrat text-muted pt-2 border-t border-surface-border/50">
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> M-Pesa / Stripe Webhook Systems
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Auth / JWT Stateless Cookies
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Isolated Job Queue Processors
          </li>
        </ul>
      </div>
    </div>

    {/* Card 3: Core Platforms */}
    <div data-inquiry="greenfield_platform" class="price-tier-card bg-surface/30 border border-surface-border hover:border-primary/50 hover:bg-surface/50 rounded-xl p-6 transition-all duration-300 flex flex-col justify-between group">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="p-2 bg-primary/10 rounded-lg text-primary text-sm shrink-0">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </span>
          <span class="text-xs font-mono font-bold text-muted-dark uppercase">[ Platform ]</span>
        </div>
        <div class="space-y-1">
          <h3 class="font-iceberg font-bold text-lg text-foreground group-hover:text-primary transition-colors">
            Greenfield & Migrations
          </h3>
          <p class="font-mono text-sm text-primary font-bold">$10,000 - $25,000+</p>
        </div>
        <p class="text-xs text-muted font-montserrat leading-relaxed">
          Build brand new service platforms from scratch, migrate databases zero-downtime, or refactor monolithic platforms to Next.js BFFs.
        </p>
        <ul class="space-y-2 text-xs font-montserrat text-muted pt-2 border-t border-surface-border/50">
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Zero-Downtime Data Migration
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Greenfield Platform Layouts
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Monolith to Microservice Splits
          </li>
        </ul>
      </div>
    </div>

    {/* Card 4: Flexible Advisory */}
    <div data-inquiry="fractional_cto" class="price-tier-card bg-surface/30 border border-surface-border hover:border-primary/50 hover:bg-surface/50 rounded-xl p-6 transition-all duration-300 flex flex-col justify-between group">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="p-2 bg-primary/10 rounded-lg text-primary text-sm shrink-0">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </span>
          <span class="text-xs font-mono font-bold text-muted-dark uppercase">[ Retainer ]</span>
        </div>
        <div class="space-y-1">
          <h3 class="font-iceberg font-bold text-lg text-foreground group-hover:text-primary transition-colors">
            Advisory & Retainers
          </h3>
          <p class="font-mono text-sm text-primary font-bold">Flexible</p>
        </div>
        <p class="text-xs text-muted font-montserrat leading-relaxed">
          For services that cannot be well quantified or scoped cleanly upfront—dynamic consulting packages, ongoing operations, or code reviews.
        </p>
        <ul class="space-y-2 text-xs font-montserrat text-muted pt-2 border-t border-surface-border/50">
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Ongoing Systems Consultation
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Dynamic Advisory Retainers
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary">✓</span> Operational Security Representation
          </li>
        </ul>
      </div>
    </div>
  </div>

</div>

<script>
  const cards = document.querySelectorAll('.price-tier-card');
  cards.forEach(card => {
    card.addEventListener('click', () => {
      const inquiry = card.getAttribute('data-inquiry');
      if (inquiry) {
        window.dispatchEvent(new CustomEvent('select-tier', { detail: { inquiry } }));
      }
    });
  });
</script>
