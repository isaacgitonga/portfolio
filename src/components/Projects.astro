---
import { SquareArrowOutUpRight } from "@lucide/astro";
import projects from "../assets/data";
---

<section id="projects" class="min-h-screen max-w-7xl mx-auto p-4 py-10">
  <div class="max-w-6xl mx-auto">
    <div class="head">
      <h1
        class="bg-linear-to-r from-secondary to-primary bg-clip-text text-transparent"
      >
        Projects
      </h1>
      <p class="text-muted text-center text-xl mt-2">
        Explore my latest work and the technologies that power them.
      </p>
    </div>

    <ul class="project-list space-y-8 mt-12">
      {
        projects.map((project) => (
          <li class="project">
            <a href={`/projects/${project.id}`} class="group block py-6">
              <h2 class="flex relative w-fit items-center justify-between text-3xl md:text-4xl font-iceberg font-bold text-primary group-hover:text-primary-hover transition-colors duration-250">
                <span>{project.title}</span>
                <SquareArrowOutUpRight size={20} class="absolute -right-5 top-0 opacity-50 text-foreground transition-all duration-200 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:opacity-100 group-hover:text-primary" />
              </h2>

              <p class="text-muted mt-3 text-base leading-relaxed max-w-4xl">
                {project.description[0]}
              </p>

              <ul class="tech-stack flex flex-wrap gap-4 mt-6 items-center">
                {Object.values(project.stack)
                  .flat()
                  .filter(Boolean)
                  .map((tech) => (
                    <li class="flex items-center gap-2">
                      <div class="size-1.5 bg-neutral-600 rounded-full" />
                      <p class="text-muted text-xs font-mono">{tech}</p>
                    </li>
                  ))}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
