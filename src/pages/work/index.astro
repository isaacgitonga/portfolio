---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ProjectItem from "@/components/ProjectItem.astro";

const rawProjects = await getCollection("projects");
const projects = rawProjects
  .filter((p) => p.data.published)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.data);
---

<Layout
  title="Projects | Isaac Gitonga"
  description="Selected engineering work, systems architecture, and transactional platforms."
>
  <section class="max-w-6xl mx-auto px-6 py-12 md:py-24 space-y-12">
    <div class="space-y-4 py-8">
      <h1 class="text-4xl font-montserrat font-bold text-foreground">
        Projects & Systems Architecture
      </h1>
      <p class="text-md text-muted font-montserrat font-medium max-w-3xl">
        A collection of backend infrastructure, fintech solutions, and full-stack applications built for correctness, concurrency, and scale.
      </p>
    </div>

    <ul class="space-y-4">
      {projects.map((project) => <ProjectItem project={project} page="projects" />)}
    </ul>
  </section>
</Layout>