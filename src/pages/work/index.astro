---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ProjectItem from "@/components/ProjectItem.astro";

const rawProjects = await getCollection("projects");
const projects = rawProjects
  .filter((p) => p.data.published)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.data);
---

<Layout
  title="Projects | Isaac Gitonga"
  description="Selected engineering work, systems architecture, and transactional platforms."
>
  <section class="max-w-6xl mx-auto px-6 py-12 md:py-24 space-y-12">
    <div class="space-y-4 max-w-3xl pb-10 border-b border-surface-border/40">
      <span class="text-xs uppercase font-mono tracking-widest text-primary font-semibold">Production Proof</span>
      <h1 class="text-4xl md:text-5xl font-montserrat font-bold text-foreground leading-tight">
        Projects & <br/><span class="text-primary font-iceberg font-normal">Systems Architecture</span>
      </h1>
      <p class="text-muted font-montserrat font-medium text-lg leading-relaxed mt-4">
        A collection of backend infrastructure, fintech solutions, and transactional systems built for correctness, concurrency, and scale.
      </p>
    </div>

    <ul class="space-y-4">
      {projects.map((project) => <ProjectItem project={project} page="work" />)}
    </ul>
  </section>
</Layout>