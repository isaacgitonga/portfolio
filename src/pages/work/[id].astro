---
import { Image } from "astro:assets";
import { MoveLeft } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import type { Project } from "@/schema/project.schema";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const publishedProjects = allProjects.filter((p) => p.data.published);
  return publishedProjects.map((entry) => ({
    params: { id: entry.data.id },
    props: { project: entry.data },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Resolve banner image dynamically
const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/projects/**/*.{jpeg,jpg,png,gif,webp,svg}");

// Resolve relative paths to absolute-like keys for import.meta.glob
let resolvedBannerPath = project.bannerUrl;
if (resolvedBannerPath.startsWith("../../..")) {
  resolvedBannerPath = resolvedBannerPath.replace("../../..", "/src");
} else if (resolvedBannerPath.startsWith("/projects")) {
  resolvedBannerPath = `/src/assets/images${resolvedBannerPath}`;
}

const hasImage = resolvedBannerPath in images;
---

<Layout
  title={`${project.title} | Projects`}
  description={project.description[0]}
>
  <section class="max-w-6xl mx-auto px-6 py-12 space-y-12">
    <!-- Back Navigation -->
    <div id="back-nav">
      <a
        href="/apps/portfolio/src/pages/work"
        class="group inline-flex items-center gap-2 text-muted hover:text-primary transition-colors font-iceberg text-sm"
      >
        <MoveLeft class="transition duration-200 group-hover:-translate-x-1" />
        <span>Back to Projects</span>
      </a>
    </div>

    <!-- Header & Meta -->
    <div class="space-y-4">
      <h1
        id="project-title"
        class="text-4xl font-iceberg font-bold text-primary"
      >
        {project.title}
      </h1>
      <p
        id="project-role"
        class="text-md text-muted font-montserrat font-medium flex flex-wrap gap-x-2 gap-y-1 items-center"
      >
        <span>{project.role}</span>
        <span>&nbsp;•&nbsp;</span>
        <span>{project.timeline}</span>
        {project.client && (
          <>
            <span>&nbsp;•&nbsp;</span>
            <span class="text-foreground font-semibold">{project.client}</span>
          </>
        )}
        {project.projectType && (
          <>
            <span>&nbsp;•&nbsp;</span>
            <span class="text-secondary font-mono text-sm">{project.projectType}</span>
          </>
        )}
      </p>

      <div id="project-status" class="flex flex-wrap gap-2 mt-4 items-center">
        {
          project.status.map((status) => (
            <p class="px-3 py-1 bg-primary/10 border border-primary/25 text-xs rounded-full text-primary font-mono font-medium">
              {status}
            </p>
          ))
        }
        {
          project.tags && project.tags.map((tag) => (
            <span class="px-2.5 py-0.5 bg-surface border border-surface-border text-xs rounded-full text-muted font-mono">
              #{tag}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Banner -->
    <div
      id="showcase"
      class="border border-surface-border rounded-xl overflow-hidden bg-surface/50"
    >
      {hasImage ? (
        <Image
          src={images[resolvedBannerPath]()}
          alt={`${project.title} Banner`}
          class="w-full h-auto object-cover max-h-96"
        />
      ) : (
        <img
          src={project.bannerUrl}
          alt={`${project.title} Banner`}
          class="w-full h-auto object-cover max-h-96"
        />
      )}
    </div>

    <!-- Layout Grid: Left Content and Right Sidebar -->
    <div id="overview" class="grid grid-cols-1 lg:grid-cols-3 gap-12 mt-12">
      <!-- Left Column: Content (takes 2 cols on desktop) -->
      <div class="lg:col-span-2 space-y-12">
        <!-- Overview -->
        <div class="space-y-4">
          <h2
            class="text-2xl font-iceberg font-bold text-foreground border-b border-surface-border pb-2"
          >
            Overview
          </h2>
          <div
            id="project-desc"
            class="space-y-4 text-muted leading-relaxed text-base"
          >
            {project.description.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <!-- Metrics & Key Outcomes (if present) -->
        {
          project.metrics && project.metrics.length > 0 && (
            <div class="space-y-4">
              <h2 class="text-2xl font-iceberg font-bold text-foreground border-b border-surface-border pb-2">
                Metrics & Key Outcomes
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {project.metrics.map((metric) => (
                  <div class="bg-surface/80 p-4 rounded-xl border border-surface-border space-y-2">
                    <p class="text-primary font-mono text-sm font-semibold flex items-center gap-2">
                      <i class="fa-solid fa-chart-line text-xs" />
                      <span>{metric}</span>
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <!-- About -->
        <div class="space-y-4">
          <h2
            class="text-2xl font-iceberg font-bold text-foreground border-b border-surface-border pb-2"
          >
            About the Project
          </h2>
          <div
            id="project-about"
            class="space-y-4 text-muted leading-relaxed text-base"
          >
            {project.about.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <!-- Key Features (if present) -->
        {
          project.features && project.features.length > 0 && (
            <div class="space-y-4">
              <h2 class="text-2xl font-iceberg font-bold text-foreground border-b border-surface-border pb-2">
                Key Deliverables & Features
              </h2>
              <ul class="space-y-3 pl-1">
                {project.features.map((feature) => (
                  <li class="flex items-start gap-3 text-muted leading-relaxed text-base">
                    <i class="fa-solid fa-check text-secondary mt-1 shrink-0 text-sm" />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <!-- Architecture Highlights -->
        <div class="space-y-4">
          <h2
            class="text-2xl font-iceberg font-bold text-foreground border-b border-surface-border pb-2"
          >
            Architecture & Engineering
          </h2>
          <ul id="architecture-list" class="space-y-3 pl-1">
            {
              project.architecture.map((item) => (
                <li class="flex items-start gap-3 text-muted leading-relaxed text-base">
                  <i class="fa-solid fa-circle-check text-primary mt-1 shrink-0" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Key Challenges -->
        <div class="space-y-6">
          <h2
            class="text-2xl font-iceberg font-bold text-foreground border-b border-surface-border pb-2"
          >
            Key Challenges
          </h2>
          <div id="challenges-container" class="space-y-6">
            {
              project.challenges.map((challenge) => (
                <div class="bg-surface/80 p-6 rounded-xl border border-surface-border space-y-4 shadow-xs">
                  <h3 class="text-xl font-bold font-iceberg text-foreground">
                    {challenge.title}
                  </h3>

                  <div class="space-y-3 font-montserrat text-sm">
                    <div class="flex gap-3">
                      <div class="shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-red-500" />
                      <p class="text-muted">
                        <strong class="text-red-400 block mb-1 font-iceberg uppercase tracking-wider text-xs">
                          Problem
                        </strong>{" "}
                        {challenge.problem}
                      </p>
                    </div>
                    <div class="flex gap-3">
                      <div class="shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-primary" />
                      <p class="text-muted">
                        <strong class="text-primary block mb-1 font-iceberg uppercase tracking-wider text-xs">
                          Solution
                        </strong>{" "}
                        {challenge.solution}
                      </p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Retrospective -->
        {
          project.retrospective && project.retrospective.length > 0 && (
            <div class="space-y-6">
              <h2
                id="retro-title"
                class="text-2xl font-iceberg font-bold text-foreground border-b border-surface-border pb-2"
              >
                Retrospective
              </h2>
              <ul id="retro-list" class="space-y-6">
                {project.retrospective.map((retro, index) => {
                  const stepNum = index + 1;
                  const paddedNum = stepNum > 9 ? `${stepNum}` : `0${stepNum}`;
                  return (
                    <li>
                      <h3 class="text-lg font-semibold text-primary font-iceberg flex items-center gap-2">
                        <span class="text-xs text-muted-dark font-mono">
                          {paddedNum}.
                        </span>
                        {retro.title}
                      </h3>
                      <p class="text-muted text-sm mt-2 leading-relaxed pl-6">
                        {retro.description}
                      </p>
                    </li>
                  );
                })}
              </ul>
            </div>
          )
        }
      </div>

      <!-- Right Column: Sidebar (takes 1 col on desktop) -->
      <div class="space-y-8">
        {(project.liveUrl || project.repoUrl) &&
          <div
            class="bg-surface/80 p-6 rounded-xl border border-surface-border space-y-4 shadow-xs"
          >
            <h3 class="font-iceberg text-lg font-bold text-foreground">
              Project Links
            </h3>
            <div class="space-y-3">
              {
                project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    class="project-link-btn flex items-center justify-center gap-2 w-full py-3 bg-primary hover:bg-primary-hover text-background font-bold font-iceberg rounded-lg transition-colors duration-250 cursor-pointer"
                  >
                    <span>Live Site</span>
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs" />
                  </a>
                )
              }

              {
                project.repoUrl && (
                  <a
                    href={project.repoUrl}
                    target="_blank"
                    class="project-link-btn flex items-center justify-center gap-2 w-full py-3 bg-surface-hover hover:bg-[#2b2f4c] text-foreground font-bold font-iceberg rounded-lg border border-surface-border transition-colors duration-250 cursor-pointer"
                  >
                    <i class="fa-brands fa-github" />
                    <span>View Source</span>
                  </a>
                )
              }
            </div>
          </div>
        }

        <!-- Tech Stack -->
        <div
          class="bg-surface/80 p-6 rounded-xl border border-surface-border space-y-6 shadow-xs"
        >
          <h3 class="font-iceberg text-lg font-bold text-foreground">
            Technologies Used
          </h3>

          {Object.entries(project.stack).map(([category, items]) => {
            if (!items || items.length === 0) return null;
            return (
              <div class="space-y-2">
                <h4 class="text-xs uppercase text-primary font-bold tracking-wider font-iceberg">
                  {category}
                </h4>
                <div class="flex flex-wrap gap-2">
                  {items.map((item) => (
                    <span class="px-2.5 py-1 bg-[#0e0f18] text-muted text-xs rounded border border-surface-border font-mono">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Related Resources / Articles (if present) -->
        {project.related && project.related.length > 0 && (
          <div class="bg-surface/80 p-6 rounded-xl border border-surface-border space-y-4 shadow-xs">
            <h3 class="font-iceberg text-lg font-bold text-foreground">
              Related Articles
            </h3>
            <div class="space-y-3">
              {project.related.map((item) => {
                const isObj = typeof item === "object";
                const url = isObj ? item.url : item;
                const title = isObj ? item.title || item.url : item;
                return (
                  <a
                    href={url}
                    target={url.startsWith("http") ? "_blank" : "_self"}
                    class="flex items-center gap-2 text-sm text-primary hover:text-primary-hover transition-colors font-mono"
                  >
                    <i class="fa-solid fa-file-lines text-xs shrink-0" />
                    <span class="line-clamp-2">{title}</span>
                  </a>
                );
              })}
            </div>
          </div>
        )}

      </div>
    </div>
  </section>
</Layout>

