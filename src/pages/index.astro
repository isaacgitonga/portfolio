---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import ServiceList from "@/components/ServiceList.astro";
import FeaturedArchitectureSpec from "@/components/FeaturedArchitectureSpec.astro";
import { getCollection } from "astro:content";
import { ArrowUpRight, CircleCheck } from "@lucide/astro";

// Fetch featured offers for the homepage
const rawServices = await getCollection("services");
const services = rawServices
  .filter((s) => s.data.featured && s.data.status === 'live')
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);

// Fetch architecture specs
const rawSpecs = await getCollection("architecture");
const publishedSpecs = rawSpecs
  .filter((s) => s.data.published)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  data-page="home"
  title="Isaac Gitonga | Principal Architect & Systems Consultant"
  description="Engineering the software your business cannot afford to get wrong. High-integrity systems advisory, payment architecture design, and concurrency-safe backends."
>
  <!-- Hero Section & Authority Pillars -->
  <Hero />

  <!-- Featured 6 Services Grid -->
  <section id="services-matrix" class="max-w-7xl mx-auto px-4 md:px-6 py-16 space-y-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-surface-border/40">
      <div class="space-y-3 max-w-2xl">
        <h5 class="text-xs uppercase font-mono tracking-widest text-primary font-semibold">Standalone Offers</h5>
        <h2 class="text-3xl md:text-4xl font-montserrat font-bold text-foreground">
          Standalone Engineering Services
        </h2>
        <p class="text-muted font-montserrat text-base">
          Fixed-scope outcomes designed to guarantee data correctness, system isolation, and operational resilience.
        </p>
      </div>
      <a
        href="/services"
        class="inline-flex items-center gap-2 px-4 py-2.5 bg-surface/60 hover:bg-surface/90 border border-surface-border text-xs font-iceberg font-bold text-foreground rounded-xl transition-all duration-200 shrink-0 cursor-pointer"
      >
        <span>View All Offers</span>
        <ArrowUpRight size={14} />
      </a>
    </div>

    <!-- Grid of Featured Services -->
    <ServiceList services={services} variant="featured" />
  </section>

  <!-- Section 5: Featured Architecture Spec Blueprint -->
  <FeaturedArchitectureSpec specs={publishedSpecs} />

  <!-- Unified 12-Hour SLA Intake CTA Banner -->
  <section class="max-w-7xl mx-auto px-4 md:px-6 py-12">
    <div class="relative bg-linear-to-r from-surface/90 via-surface-hover/80 to-surface/90 border border-primary/25 rounded-2xl p-8 md:p-12 overflow-hidden flex flex-col md:flex-row justify-between items-center gap-8 shadow-xl">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_50%,rgba(56,189,248,0.08),transparent)] pointer-events-none"></div>
      
      <div class="space-y-4 z-10 max-w-2xl text-center md:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-primary text-[11px] font-mono font-semibold">
          <CircleCheck size={12} class="text-emerald-400 shrink-0" />
          <span>Guaranteed Personal Response Within 12 Hours</span>
        </div>
        <h2 class="text-2xl md:text-3xl font-iceberg font-bold text-foreground leading-tight">
          Facing fragile bottlenecks or preparing for high traffic?
        </h2>
        <p class="text-muted text-sm font-montserrat leading-relaxed">
          Let's evaluate your database limits, secure your tenant isolation boundaries, and establish audit-ready system resilience.
        </p>
      </div>

      <div class="z-10 shrink-0">
        <a
          href="/inquiry"
          class="flex items-center justify-center gap-2 px-6 py-4 bg-primary hover:bg-primary-hover text-background font-bold font-iceberg text-base rounded-xl transition-all duration-200 shadow-lg shadow-primary/20 hover:shadow-primary/30 active:scale-98 cursor-pointer"
        >
          <span>Submit System Inquiry</span>
          <ArrowUpRight size={18} />
        </a>
      </div>
    </div>
  </section>
</Layout>
