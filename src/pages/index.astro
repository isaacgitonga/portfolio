---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Skills from "../components/Skills.astro";
import ProjectItem from "../components/ProjectItem.astro";
import Reviews from "../components/Reviews.astro";
import { getCollection } from "astro:content";

const rawProjects = await getCollection("projects");
const projects = rawProjects
  .filter((p) => p.data.published)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.data);
---

<Layout data-page="home" title="Isaac Gitonga | Software Architect">
  <Hero />
  <Skills />

  <section id="projects" class="min-h-screen max-w-7xl mx-auto p-4 py-10">
    <div class="max-w-6xl mx-auto">
      <div class="head">
        <h1
          class="bg-linear-to-r from-secondary to-primary bg-clip-text text-transparent"
        >
          Projects
        </h1>
        <p class="text-muted text-center text-xl mt-2">
          Explore my latest work and the technologies that power them.
        </p>
      </div>

      <ul class="project-list space-y-4 mt-12">
        {projects.map((project) => <ProjectItem project={project} page="home" />)}
      </ul>
    </div>
  </section>

  <Reviews />
</Layout>
