---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Blog`} description={post.data.description}>
  <article class="max-w-3xl mx-auto px-6 py-12 md:py-24 space-y-8">
    <!-- Navigation -->
    <div>
      <a href="/blog" class="group inline-flex items-center gap-2 text-muted hover:text-primary transition-colors font-iceberg text-sm">
        <i class="fa-solid fa-arrow-left transtion duration-200 group-hover:-translate-x-1"></i>
        <span>Back to Blog</span>
      </a>
    </div>

    <!-- Header metadata -->
    <div class="space-y-4 border-b border-neutral-900 pb-8">
      <div class="flex items-center gap-4 text-xs font-mono text-muted-dark">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        <span>•</span>
        <span>Written by {post.data.author}</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-iceberg font-bold text-primary leading-tight">
        {post.data.title}
      </h1>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-2">
          {post.data.tags.map((tag) => (
            <span class="px-2 py-0.5 bg-neutral-900 border border-neutral-800 text-[10px] rounded-sm text-primary font-mono">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Content markdown body -->
    <div class="prose prose-invert max-w-none prose-neutral font-nunito leading-relaxed text-muted mt-8">
      <Content />
    </div>
  </article>
</Layout>

<style is:global>
  @reference "../../styles/global.css";

  .prose h2 {
    @apply text-2xl font-bold font-iceberg text-foreground mt-8 mb-4 border-b border-neutral-900 pb-2;
  }
  .prose h3 {
    @apply text-xl font-bold font-iceberg text-foreground mt-6 mb-3;
  }
  .prose p {
    @apply mb-4 text-muted text-base leading-relaxed;
  }
  .prose ul {
    @apply list-disc pl-6 mb-4 space-y-2 text-muted;
  }
  .prose ol {
    @apply list-decimal pl-6 mb-4 space-y-2 text-muted;
  }
  .prose li {
    @apply text-muted;
  }
  .prose strong {
    @apply text-foreground font-semibold;
  }
</style>
