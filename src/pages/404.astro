---
import Layout from "@/layouts/Layout.astro";
import BinaryBackground from "@/components/BinaryBackground.astro";
import { ArrowLeft, Home } from "@lucide/astro";
---

<Layout title="404: Page Not Found | Isaac Gitonga">
  <div class="relative min-h-[80vh] flex items-center justify-center px-6 overflow-hidden">
    <!-- Thematic background -->
    <BinaryBackground className="opacity-40" />

    <div class="relative z-10 max-w-2xl w-full text-center space-y-8 py-16">
      <!-- Glow Header -->
      <div class="space-y-2">
        <p class="font-mono text-xs uppercase tracking-widest text-secondary font-bold animate-pulse">
          [ ERROR: 404_PAGE_NOT_FOUND ]
        </p>
        <h1 class="text-8xl md:text-9xl font-iceberg font-bold text-primary tracking-tighter drop-shadow-[0_0_15px_rgba(20,184,166,0.3)]">
          404
        </h1>
      </div>

      <!-- Developer themed copy -->
      <div class="space-y-4 max-w-lg mx-auto">
        <h2 class="text-2xl font-iceberg font-bold text-foreground">
          Requested abstraction not found.
        </h2>
        <p class="text-muted text-base leading-relaxed font-montserrat font-medium">
          The path you are looking for has either been garbage collected, migrated to a new namespace, or never existed in the machine's local storage.
        </p>
      </div>

      <!-- Diagnostics Display -->
      <div class="bg-surface/60 border border-surface-border rounded-xl p-5 text-left font-mono text-xs text-muted max-w-md mx-auto space-y-2 backdrop-blur-xs">
        <div class="flex justify-between border-b border-surface-border pb-1">
          <span class="text-muted-dark">SYS.STATUS:</span>
          <span class="text-red-400 font-semibold">NOT_FOUND</span>
        </div>
        <div class="flex justify-between border-b border-surface-border pb-1">
          <span class="text-muted-dark">NAMESPACE:</span>
          <span class="text-foreground">@core/portfolio</span>
        </div>
        <div class="flex justify-between">
          <span class="text-muted-dark">RESOLVER:</span>
          <span class="text-foreground">astro:router</span>
        </div>
      </div>

      <!-- Navigation Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a
          href="javascript:history.back()"
          class="flex items-center justify-center gap-2 px-6 py-3 bg-surface border border-surface-border hover:bg-surface-hover text-foreground font-bold font-iceberg rounded-lg transition-colors w-full sm:w-auto cursor-pointer"
        >
          <ArrowLeft size={16} />
          <span>Go Back</span>
        </a>
        <a
          href="/"
          class="flex items-center justify-center gap-2 px-6 py-3 bg-primary hover:bg-primary-hover text-background font-bold font-iceberg rounded-lg transition-colors w-full sm:w-auto cursor-pointer"
        >
          <Home size={16} />
          <span>Return Home</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
