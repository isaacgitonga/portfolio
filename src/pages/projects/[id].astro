---
import Layout from '../../layouts/Layout.astro';
import projects from '../../assets/data';
import type { Project } from '../../types';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Projects`} description={project.description[0]}>
  <section class="max-w-6xl mx-auto px-6 py-12 md:py-24 space-y-12">
    <!-- Back Navigation -->
    <div>
      <a href="/#projects" class="inline-flex items-center gap-2 text-muted hover:text-primary transition-colors font-iceberg text-sm">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to Projects</span>
      </a>
    </div>

    <!-- Header & Meta -->
    <div class="space-y-4">
      <h1 class="text-4xl md:text-6xl font-iceberg font-bold text-primary">{project.title}</h1>
      <p class="text-lg text-muted font-montserrat font-medium">
        {project.role} &nbsp;•&nbsp; {project.timeline}
      </p>
      
      <div class="flex flex-wrap gap-2 mt-4">
        {project.status.map((status) => (
          <span class="px-3 py-1 bg-neutral-900 border border-neutral-800 text-xs rounded-full text-primary font-mono font-medium">
            {status}
          </span>
        ))}
      </div>
    </div>

    <!-- Banner -->
    <div class="border border-neutral-900 rounded-xl overflow-hidden bg-neutral-950">
      <img 
        src={project.bannerUrl} 
        alt={`${project.title} Banner`}
        class="w-full h-auto object-cover max-h-96"
      />
    </div>

    <!-- Layout Grid: Left Content and Right Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 mt-12">
      <!-- Left Column: Content (takes 2 cols on desktop) -->
      <div class="lg:col-span-2 space-y-12">
        <!-- Overview -->
        <div class="space-y-4">
          <h2 class="text-2xl font-iceberg font-bold text-foreground border-b border-neutral-900 pb-2">Overview</h2>
          <div class="space-y-4 text-muted leading-relaxed text-base">
            {project.description.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </div>

        <!-- About -->
        <div class="space-y-4">
          <h2 class="text-2xl font-iceberg font-bold text-foreground border-b border-neutral-900 pb-2">About the Project</h2>
          <div class="space-y-4 text-muted leading-relaxed text-base">
            {project.about.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </div>

        <!-- Architecture Highlights -->
        <div class="space-y-4">
          <h2 class="text-2xl font-iceberg font-bold text-foreground border-b border-neutral-900 pb-2">Architecture & Engineering</h2>
          <ul class="space-y-3 pl-1">
            {project.architecture.map((item) => (
              <li class="flex items-start gap-3 text-muted leading-relaxed text-base">
                <i class="fa-solid fa-circle-check text-primary mt-1 shrink-0"></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Key Challenges -->
        <div class="space-y-6">
          <h2 class="text-2xl font-iceberg font-bold text-foreground border-b border-neutral-900 pb-2">Key Challenges</h2>
          <div class="space-y-6">
            {project.challenges.map((challenge) => (
              <div class="bg-neutral-900/40 p-6 rounded-lg border border-neutral-800 space-y-4">
                <h3 class="text-xl font-bold font-iceberg text-foreground">{challenge.title}</h3>
                
                <div class="space-y-3 font-montserrat text-sm">
                  <div class="flex gap-3">
                    <div class="shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-red-500"></div>
                    <p class="text-muted"><strong class="text-red-400 block mb-1 font-iceberg uppercase tracking-wider text-xs">Problem</strong> {challenge.problem}</p>
                  </div>
                  <div class="flex gap-3">
                    <div class="shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-primary"></div>
                    <p class="text-muted"><strong class="text-primary block mb-1 font-iceberg uppercase tracking-wider text-xs">Solution</strong> {challenge.solution}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Retrospective -->
        {project.retrospective && project.retrospective.length > 0 && (
          <div class="space-y-6">
            <h2 class="text-2xl font-iceberg font-bold text-foreground border-b border-neutral-900 pb-2">Retrospective</h2>
            <ul class="space-y-6">
              {project.retrospective.map((retro, index) => {
                const stepNum = index + 1;
                const paddedNum = stepNum > 9 ? `${stepNum}` : `0${stepNum}`;
                return (
                  <li>
                    <h3 class="text-lg font-semibold text-primary font-iceberg flex items-center gap-2">
                      <span class="text-xs text-muted-dark font-mono">{paddedNum}.</span>
                      {retro.title}
                    </h3>
                    <p class="text-muted text-sm mt-2 leading-relaxed pl-6">{retro.description}</p>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </div>

      <!-- Right Column: Sidebar (takes 1 col on desktop) -->
      <div class="space-y-8">
        <!-- Links -->
        <div class="bg-neutral-900/30 p-6 rounded-xl border border-neutral-900 space-y-4">
          <h3 class="font-iceberg text-lg font-bold text-foreground">Project Links</h3>
          <div class="space-y-3">
            {project.liveUrl && (
              <a 
                href={project.liveUrl} 
                target="_blank"
                class="flex items-center justify-center gap-2 w-full py-3 bg-primary hover:bg-primary-hover text-background font-bold font-iceberg rounded-lg transition-colors duration-250 cursor-pointer"
              >
                <span>Live Site</span>
                <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
              </a>
            )}
            
            {project.repoUrl && (
              <a 
                href={project.repoUrl} 
                target="_blank"
                class="flex items-center justify-center gap-2 w-full py-3 bg-neutral-800 hover:bg-neutral-700 text-foreground font-bold font-iceberg rounded-lg border border-neutral-700 transition-colors duration-250 cursor-pointer"
              >
                <i class="fa-brands fa-github"></i>
                <span>View Source</span>
              </a>
            )}
          </div>
        </div>

        <!-- Tech Stack -->
        <div class="bg-neutral-900/30 p-6 rounded-xl border border-neutral-900 space-y-6">
          <h3 class="font-iceberg text-lg font-bold text-foreground">Technologies Used</h3>
          
          {Object.entries(project.stack).map(([category, items]) => {
            if (!items || items.length === 0) return null;
            return (
              <div class="space-y-2">
                <h4 class="text-xs uppercase text-primary font-bold tracking-wider font-iceberg">{category}</h4>
                <div class="flex flex-wrap gap-2">
                  {items.map((item) => (
                    <span class="px-2 py-1 bg-neutral-950 text-muted text-xs rounded border border-neutral-800 font-mono">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>
