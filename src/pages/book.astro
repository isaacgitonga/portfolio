---
import Layout from "@/layouts/Layout.astro";
import BookingWizard from "@/components/react/BookingWizard.tsx";
import PriceTiers from "@/components/PriceTiers.astro";
import Socials from "@/components/Socials.astro";
import CopyIcon from "@/components/CopyIcon.astro";
---

<Layout
  title="Book an Architectural Audit | Isaac Gitonga"
  description="Qualified intake funnel to book high-value advisory, backend system audits, or payment safety reviews."
>
  <div class="relative flex flex-col justify-center px-6 overflow-hidden">
    <div class="relative z-10 max-w-6xl w-full mx-auto py-24 md:py-32 space-y-12">
      <!-- Header & Intro -->
      <div class="space-y-4 pb-20">
        <h1 class="text-3xl md:text-4xl font-montserrat font-bold text-foreground">
          Book an Architectural Audit
        </h1>
        <p class="text-muted font-montserrat font-medium max-w-3xl leading-relaxed">
          Provide your system parameters and outline constraints. Qualified submissions receive a detailed scoping session and direct advisory access.
        </p>
        <p class="text-sm font-montserrat text-muted font-semibold pt-2">
          Prefer to align via email first?
          <a
            href="/contact"
            class="inline-flex items-center gap-1 font-iceberg font-bold text-primary hover:underline ml-1"
          >
            Open the general contact form →
          </a>
        </p>
      </div>

      <!-- Pricing Scopes (Full-Width outside the layout grid) -->
      <PriceTiers />

      <hr class="border-surface-border/30" />

      <!-- Layout Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start mt-8">
        <!-- Booking Wizard Component -->
        <div class="lg:col-span-2 bg-surface/50 border border-surface-border rounded-2xl p-6 md:p-8 backdrop-blur-xs">
          <BookingWizard client:load />
        </div>

        <!-- Sidebar / Contact Details -->
        <div class="space-y-8">
          <!-- Qualification standards -->
          <div class="bg-surface/50 border border-surface-border rounded-xl p-6 space-y-4 backdrop-blur-xs">
            <h3 class="font-iceberg text-lg font-bold text-foreground">
              Availability
            </h3>
            <div class="space-y-2 text-sm text-muted font-montserrat">
              <div class="flex justify-between border-b border-surface-border/50 pb-2">
                <span>Consulting:</span>
                <span class="text-primary font-semibold">Active</span>
              </div>
              <div class="flex justify-between border-b border-surface-border/50 pb-2">
                <span>Contract Work:</span>
                <span class="text-primary font-semibold">Open</span>
              </div>
              <div class="flex justify-between">
                <span>Location:</span>
                <span class="text-foreground">Nairobi, Kenya / Remote</span>
              </div>
            </div>
          </div>

          <!-- Email Bypass Escape Hatch -->
          <div class="bg-surface/50 border border-surface-border rounded-xl p-6 space-y-4 backdrop-blur-xs">
            <h3 class="font-iceberg text-lg font-bold text-foreground">
              Prefer Email First?
            </h3>
            <p class="text-xs text-muted font-montserrat leading-relaxed">
              If you aren't ready to schedule a call or need to share a system design specification/RFP first, feel free to bypass the calendar and initiate an email thread directly.
            </p>
            <div class="flex items-center justify-between p-3 bg-background border border-surface-border rounded-lg">
              <div class="flex flex-col gap-0.5 w-[calc(100%-2.5rem)]">
                <span class="text-[10px] text-muted-dark font-iceberg uppercase tracking-wider font-semibold">Direct Inbox</span>
                <span class="text-xs font-montserrat text-foreground font-medium break-all selection:bg-primary/20">
                  advisory@isaacgitonga.com
                </span>
              </div>
              <CopyIcon text="advisory@isaacgitonga.com" class="shrink-0" />
            </div>
          </div>

          <!-- Direct Connections -->
          <div class="bg-surface/50 border border-surface-border rounded-xl p-6 space-y-4 backdrop-blur-xs">
            <h3 class="font-iceberg text-lg font-bold text-foreground">
              Direct channels
            </h3>
            <div class="space-y-4">
              <div class="flex items-center justify-between p-3 bg-background border border-surface-border rounded-lg">
                <span class="text-xs text-muted-dark font-iceberg uppercase tracking-wider font-semibold">Socials</span>
                <Socials gap={4} />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
